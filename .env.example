# ─────────────────────────────────────────────────────────────
# StockCast 환경변수 예시 — 이 파일을 .env 로 복사해 값을 채운다.
# .env 는 .gitignore 로 제외된다(키가 깃에 올라가지 않게).
# 외부 키는 전부 선택 사항 — 없으면 해당 수집을 건너뛰고 합성/규칙으로 동작한다.
# ─────────────────────────────────────────────────────────────

# ── 분석계 DB (PostgreSQL) ──
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_pass
POSTGRES_DB=erp_nfc
# 로컬(호스트)에서 직접 실행할 때. docker compose 는 compose 파일이 db 호스트로 덮어쓴다.
DATABASE_URL=postgresql+psycopg://erp:erp_pass@localhost:5432/erp_nfc

# ── 분석계 DB를 AWS RDS로 돌릴 때만 채운다 ──
# docker-compose.rds.yml 을 함께 쓸 때 이 두 값이 위의 DATABASE_URL 을 대신한다.
#   docker compose -f docker-compose.yml -f docker-compose.rds.yml up -d
#
# 이름을 DATABASE_URL 로 안 하고 굳이 RDS_ 를 붙인 이유가 있다.
# 위에 이미 로컬용 DATABASE_URL 이 있어서, 같은 이름을 쓰면 RDS 설정을 깜빡해도
# "값이 있으니까" 그냥 넘어가고 컨테이너가 자기 자신의 localhost 로 붙는다.
# 이름을 다르게 두면 안 채웠을 때 기동 자체가 멈춘다.
#
# 값은 terraform output 으로 얻는다.
#   terraform -chdir=infra/terraform output -raw rds_database_url
#   terraform -chdir=infra/terraform output -raw rds_database_url_psycopg
RDS_DATABASE_URL=
RDS_DATABASE_URL_PSYCOPG=

# ── 외부 공공 API (공공데이터포털 발급 · 선택) ──
KMA_API_KEY=              # 기상청 ASOS 일자료 — 수요 동인(기온·강수)
HOLIDAY_API_KEY=          # 한국천문연구원 특일정보 — 공휴일 보정
NARA_API_KEY=             # 조달청 나라장터 입찰공고(물품) — 실수요 신호
PPS_API_KEY=              # 조달청 종합쇼핑몰 MAS — 실 계약단가
PPS_SHOP_URL=             # 종합쇼핑몰 전체 요청 URL(명세가 JS라 URL로 받는다)
KOSIS_RETAIL_URL=         # 통계청 KOSIS 소매판매액지수 OpenAPI 전체 URL

# ── 운영계 ERP (Odoo 18) ──
# 백엔드 컨테이너 → 호스트의 Odoo는 host.docker.internal 로 접근한다.
ODOO_URL=http://host.docker.internal:8069
ODOO_DB=stockcast
ODOO_USERNAME=admin@stockcast.local
ODOO_PASSWORD=            # Odoo 관리자 비밀번호 또는 API 키
ODOO_API_KEY=

# ── AI (운영 요약 · 챗봇) ──
# gemini = 클라우드 무료등급 / ollama = 로컬 / rule = LLM 미사용(항상 규칙 기반)
LLM_PROVIDER=gemini
GEMINI_API_KEY=           # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── HTTPS (Caddy 리버스 프록시) ──
STOCKCAST_DOMAIN=            # 예: my-stockcast.duckdns.org

# ── DuckDNS 자동 갱신 (선택) ──
# EIP 를 안 쓰고 필요할 때만 서버를 켜는 방식이면 켤 때마다 공인 IP가 바뀐다.
# scripts/aws_server.sh start 가 시작 후 이 값으로 DuckDNS 주소를 갱신한다.
# EIP 는 인스턴스가 멈춰 있어도 시간당 요금이 붙어서, 자주 껐다 켤 거면 이쪽이 싸다.
DUCKDNS_DOMAIN=              # .duckdns.org 앞부분만 (예: my-stockcast)
DUCKDNS_TOKEN=                       # https://www.duckdns.org 로그인 후 확인

# ── 로그인 (관리자 / 조회 계정) ──
# 비밀번호를 비워 두면 그 계정은 로그인할 수 없다. 둘 다 비우면 아무도 못 들어간다.
# 값 만들기: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
AUTH_SECRET=                 # 토큰 서명 키. 비우면 재시작할 때마다 로그인이 풀린다
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=
AUTH_VIEWER_USERNAME=viewer
AUTH_VIEWER_PASSWORD=

# ── 로그 ──
# 요청·수집 로그를 남길 곳. 기본은 저장소/logs (컨테이너에서는 /workspace/logs).
# LOG_DIR=
